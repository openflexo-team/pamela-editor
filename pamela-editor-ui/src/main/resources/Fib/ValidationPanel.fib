<?xml version="1.0" encoding="UTF-8"?>
<!--
  ValidationPanel.fib
  The collapsible bottom pane of the center column's JSplitPane (validation-log-panel-design.md).

  Shows the active project's SourceMetaModel issues (errors / warnings / infos) as a table.
  The always-visible summary label + Revalidate link live separately, in
  ValidationHeaderView.fib (PamelaEditorApplication.centerColumn's SOUTH, below the split) —
  so they stay visible even while this table is collapsed.
-->
<Panel id="0" font="SansSerif,0,11" darkLevel="0" useScrollBar="false" layout="border" name="ValidationPanel"
    dataClassName="org.openflexo.pamela.editor.model.SourceMetaModel"
    controllerClassName="org.openflexo.pamela.editor.ui.widget.ValidationFIBController"
    trackViewPortWidth="true" trackViewPortHeight="true"
    borderTop="0" borderLeft="0" borderBottom="0" borderRight="0" border="empty">

    <!-- FlatDesign tables always wrap their JTable in their own JScrollPane (JFDTablePanel),
         so the issues list scrolls on its own once it overflows the strip's allocated height —
         no outer useScrollBar is needed (and would double up with this one). visibleRowCount
         is a sizing hint only. -->
    <Table id="20"
        lookAndFeel="FlatDesign"
        data="data.issues"
        iteratorClassName="org.openflexo.pamela.editor.model.Issue"
        rowHeight="18"
        visibleRowCount="8"
        showHeader="false"
        showFooter="false"
        selectionMode="SingleSelection"
        backgroundSelectionColor="9,80,208"
        backgroundNonSelectionColor="255,255,255"
        backgroundSecondarySelectionColor="178,215,255"
        textSelectionColor="255,255,255"
        textNonSelectionColor="0,0,0"
        textSecondarySelectionColor="0,0,0"
        manageDynamicModel="true"
        clickAction="controller.selectIssue(issuesTable.selected)"
        constraints="border(location=center)"
        name="issuesTable">
        <IconColumn id="21" data="controller.iconForObject(iterator)"
            title="" displayTitle="false" columnWidth="20" resizable="false" name="IssueIcon" />
        <TextFieldColumn id="22" data="iterator.message"
            title="message" displayTitle="false" resizable="true" columnWidth="600"
            showIcon="false" readOnly="true" name="IssueMessage" />
    </Table>

</Panel>
