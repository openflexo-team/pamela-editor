<?xml version="1.0" encoding="UTF-8"?>
<Panel dataClassName="org.openflexo.pamela.editor.ui.action.ChangePropertyTypeAction"
       controllerClassName="org.openflexo.gina.controller.FIBController"
       layout="twocols" name="ChangePropertyTypeForm" border="empty">

  <Label name="typeLabel" label="New type:" localize="false" align="left"
         index="0" constraints="twocols(location=left)" />
  <DropDown name="typeDD" data="data.type" list="data.typeChoices"
         iteratorClassName="java.lang.String" showReset="false" width="260"
         index="1" constraints="twocols(expandHorizontally=true;location=right)" />
</Panel>
