<?xml version="1.0" encoding="UTF-8"?>
<Panel dataClassName="org.openflexo.pamela.editor.ui.action.ChangePropertyTypeAction"
       controllerClassName="org.openflexo.gina.controller.FIBController"
       layout="twocols" name="ChangePropertyTypeForm" border="empty" width="400" height="100">

  <Label name="typeLabel" label="New type:" localize="false" align="left"
         index="0" constraints="twocols(location=left)" />
  <Custom name="typeSelector" componentClassName="org.openflexo.gina.swing.utils.TypeSelector"
         data="data.type" manageDynamicModel="true" width="260"
         index="1" constraints="twocols(expandHorizontally=true;location=right)">
    <Assignment variable="component.customTypeManager" value="data.customTypeManager" />
    <Assignment variable="component.customTypeEditorProvider" value="data.customTypeEditorProvider" />
  </Custom>
</Panel>
