<?xml version="1.0" encoding="UTF-8"?>
<Panel dataClassName="org.openflexo.pamela.editor.ui.action.AddAsRootTypeAction"
       controllerClassName="org.openflexo.gina.controller.FIBController"
       layout="twocols" name="AddAsRootTypeForm" border="empty" width="420" height="90">

  <Label name="typeLabel" label="type_colon_label" localize="true"
         align="left" index="0" constraints="twocols(location=left)" />
  <Custom name="typeSelector"
         componentClassName="org.openflexo.pamela.editor.ui.widget.JavaClassSelector"
         data="data.selectedType" manageDynamicModel="true" width="280"
         index="1" constraints="twocols(expandHorizontally=true;location=right)">
    <Assignment variable="component.metaModel" value="data.metaModel" />
    <Assignment variable="component.restrictedValues" value="data.candidateTypes" />
  </Custom>
  <LocalizedDictionary>
    <Localized key="type_colon_label" lang="English" value="Type:" />
    <Localized key="type_colon_label" lang="French" value="Type :" />
    <Localized key="type_colon_label" lang="Dutch" value="Type:" />
  </LocalizedDictionary>
</Panel>
