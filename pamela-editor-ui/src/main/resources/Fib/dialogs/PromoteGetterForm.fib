<?xml version="1.0" encoding="UTF-8"?>
<!--
  PromoteGetterForm.fib — "Promote as New Property" (model-editing-design.md §3.3a).
  Property id + (read-only) cardinality, then one optional row per sibling accessor the property
  could pull in. Each role row is shown only when relevant (cardinality) and candidates exist
  (data.<role>Option.show), and carries a "also promote" checkbox + a dropdown of matching methods.
-->
<Panel dataClassName="org.openflexo.pamela.editor.ui.action.PromoteGetterAction"
       controllerClassName="org.openflexo.gina.controller.FIBController"
       layout="twocols" name="PromoteGetterForm" border="empty" width="400" height="200">

  <Label name="idLabel" label="Property name:" localize="false" align="left"
         index="0" constraints="twocols(location=left)" />
  <TextField name="idTF" data="data.propertyIdentifier" columns="22" validateOnReturn="false"
         index="1" constraints="twocols(expandHorizontally=true;location=right)" />

  <Label name="cardLabel" label="Cardinality:" localize="false" align="left"
         index="2" constraints="twocols(location=left)" />
  <TextField name="cardValue" data="data.cardinalityLabel" readOnly="true" columns="22"
         index="3" constraints="twocols(expandHorizontally=true;location=right)" />

  <!-- SINGLE: setter -->
  <Label name="setterLabel" label="Setter:" localize="false" align="left"
         visible="data.setterOption.show"
         index="4" constraints="twocols(location=left)" />
  <Panel name="setterRow" layout="flow" flowAlignment="LEFT" border="empty"
         borderTop="0" borderBottom="0" borderLeft="0" borderRight="0" hGap="3" vGap="0"
         visible="data.setterOption.show"
         index="5" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="setterCB" data="data.setterOption.include" />
    <Custom name="setterSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.setterOption.method" manageDynamicModel="true" width="200">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.setterOption.candidates" />
    </Custom>
  </Panel>

  <!-- SINGLE: updater -->
  <Label name="updaterLabel" label="Updater:" localize="false" align="left"
         visible="data.updaterOption.show"
         index="6" constraints="twocols(location=left)" />
  <Panel name="updaterRow" layout="flow" flowAlignment="LEFT" border="empty"
         borderTop="0" borderBottom="0" borderLeft="0" borderRight="0" hGap="3" vGap="0"
         visible="data.updaterOption.show"
         index="7" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="updaterCB" data="data.updaterOption.include" />
    <Custom name="updaterSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.updaterOption.method" manageDynamicModel="true" width="200">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.updaterOption.candidates" />
    </Custom>
  </Panel>

  <!-- LIST: adder -->
  <Label name="adderLabel" label="Adder:" localize="false" align="left"
         visible="data.adderOption.show"
         index="8" constraints="twocols(location=left)" />
  <Panel name="adderRow" layout="flow" flowAlignment="LEFT" border="empty"
         borderTop="0" borderBottom="0" borderLeft="0" borderRight="0" hGap="3" vGap="0"
         visible="data.adderOption.show"
         index="9" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="adderCB" data="data.adderOption.include" />
    <Custom name="adderSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.adderOption.method" manageDynamicModel="true" width="200">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.adderOption.candidates" />
    </Custom>
  </Panel>

  <!-- LIST: remover -->
  <Label name="removerLabel" label="Remover:" localize="false" align="left"
         visible="data.removerOption.show"
         index="10" constraints="twocols(location=left)" />
  <Panel name="removerRow" layout="flow" flowAlignment="LEFT" border="empty"
         borderTop="0" borderBottom="0" borderLeft="0" borderRight="0" hGap="3" vGap="0"
         visible="data.removerOption.show"
         index="11" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="removerCB" data="data.removerOption.include" />
    <Custom name="removerSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.removerOption.method" manageDynamicModel="true" width="200">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.removerOption.candidates" />
    </Custom>
  </Panel>

  <!-- LIST: reindexer -->
  <Label name="reindexerLabel" label="Reindexer:" localize="false" align="left"
         visible="data.reindexerOption.show"
         index="12" constraints="twocols(location=left)" />
  <Panel name="reindexerRow" layout="flow" flowAlignment="LEFT" border="empty"
         borderTop="0" borderBottom="0" borderLeft="0" borderRight="0" hGap="3" vGap="0"
         visible="data.reindexerOption.show"
         index="13" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="reindexerCB" data="data.reindexerOption.include" />
    <Custom name="reindexerSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.reindexerOption.method" manageDynamicModel="true" width="200">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.reindexerOption.candidates" />
    </Custom>
  </Panel>
</Panel>
