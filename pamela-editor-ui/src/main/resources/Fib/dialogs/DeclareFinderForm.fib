<?xml version="1.0" encoding="UTF-8"?>
<!--
  DeclareFinderForm.fib — "Declare as Finder" (model-editing-design.md §3.3a).
  collection = the LIST property to search; attribute = the element property matched against the
  argument; cardinality is derived from the return type (read-only).
-->
<Panel dataClassName="org.openflexo.pamela.editor.ui.action.DeclareAsFinderAction"
       controllerClassName="org.openflexo.gina.controller.FIBController"
       layout="twocols" name="DeclareFinderForm" border="empty">

  <Label name="collLabel" label="Collection (list property):" localize="false" align="left"
         index="0" constraints="twocols(location=left)" />
  <DropDown name="collDD" data="data.collection" list="data.collectionChoices"
         iteratorClassName="java.lang.String" showReset="false" width="220"
         index="1" constraints="twocols(expandHorizontally=true;location=right)" />

  <Label name="attrLabel" label="Attribute (search key):" localize="false" align="left"
         index="2" constraints="twocols(location=left)" />
  <DropDown name="attrDD" data="data.attribute" list="data.attributeChoices"
         iteratorClassName="java.lang.String" showReset="false" width="220"
         index="3" constraints="twocols(expandHorizontally=true;location=right)" />

  <Label name="cardLabel" label="Result:" localize="false" align="left"
         index="4" constraints="twocols(location=left)" />
  <TextField name="cardValue" data="data.multiValuedLabel" readOnly="true" columns="22"
         index="5" constraints="twocols(expandHorizontally=true;location=right)" />
</Panel>
