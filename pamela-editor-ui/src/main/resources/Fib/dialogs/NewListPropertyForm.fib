<?xml version="1.0" encoding="UTF-8"?>
<!--
  NewListPropertyForm.fib — "New list property" (model-editing-design.md §3.3 / §5bis).
  Header + identifier + type, then getter/adder/remover/reindexer rows. Each row: checkbox +
  mode dropdown (Generate/Attach) + (generate) editable name field OR (attach) filtered
  selector (both fill the row), with a right-justified italic summary below.
-->
<Panel dataClassName="org.openflexo.pamela.editor.ui.action.NewListPropertyAction"
       controllerClassName="org.openflexo.gina.controller.FIBController"
       layout="twocols" name="NewListPropertyForm" border="empty" width="600" height="340">

  <Label name="header" data="data.headerSummary" localize="false" align="center" font="SansSerif,1,14"
         index="0" constraints="twocols(expandHorizontally=true;location=center;insetsTop=10;insetsBottom=10)" />

  <Label name="idLabel" label="Identifier" localize="false" align="left"
         index="1" constraints="twocols(location=left)" />
  <TextField name="idTF" data="data.identifier" columns="22" validateOnReturn="false"
         index="2" constraints="twocols(expandHorizontally=true;location=right)" />

  <Label name="typeLabel" label="Element type" localize="false" align="left"
         index="3" constraints="twocols(location=left)" />
  <Custom name="typeSelector" componentClassName="org.openflexo.gina.swing.utils.TypeSelector"
         data="data.type" manageDynamicModel="true" width="260"
         index="4" constraints="twocols(expandHorizontally=true;location=right)">
    <Assignment variable="component.customTypeManager" value="data.customTypeManager" />
    <Assignment variable="component.customTypeEditorProvider" value="data.customTypeEditorProvider" />
  </Custom>

  <Label name="getterLabel" label="Getter:" localize="false" align="left"
         index="5" constraints="twocols(location=left)" />
  <Panel name="getterRow" layout="gridbag" border="empty"
         index="6" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="getterCB" data="data.getterOption.include" enable="data.getterOption.toggleable"
           constraints="gridbag(gridX=0;gridY=0;weightX=0.0;fill=none;anchor=west;insetsRight=3)" />
    <DropDown name="getterMode" data="data.getterOption.mode" list="data.getterOption.availableModes"
           iteratorClassName="org.openflexo.pamela.editor.ui.action.AccessorOption$Mode"
           format="object.label"
           constraints="gridbag(gridX=1;gridY=0;weightX=0.0;fill=none;anchor=west;insetsRight=3)" />
    <TextField name="getterName" data="data.getterOption.generatedName" columns="10" validateOnReturn="false"
           visible="data.getterOption.generateMode"
           constraints="gridbag(gridX=2;gridY=0;weightX=1.0;fill=horizontal;anchor=west)" />
    <Custom name="getterSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.getterOption.method" manageDynamicModel="true"
           visible="data.getterOption.attachMode"
           constraints="gridbag(gridX=2;gridY=0;weightX=1.0;fill=horizontal;anchor=west)">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.getterOption.candidates" />
    </Custom>
    <Label name="getterSummary" data="data.getterOption.summary" localize="false" align="left" font="SansSerif,2,10"
           constraints="gridbag(gridX=0;gridY=1;gridWidth=3;weightX=1.0;fill=horizontal;anchor=west;insetsTop=1)" />
  </Panel>

  <Label name="adderLabel" label="Adder:" localize="false" align="left"
         index="7" constraints="twocols(location=left)" />
  <Panel name="adderRow" layout="gridbag" border="empty"
         index="8" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="adderCB" data="data.adderOption.include"
           constraints="gridbag(gridX=0;gridY=0;weightX=0.0;fill=none;anchor=west;insetsRight=3)" />
    <DropDown name="adderMode" data="data.adderOption.mode" list="data.adderOption.availableModes"
           iteratorClassName="org.openflexo.pamela.editor.ui.action.AccessorOption$Mode"
           format="object.label" enable="data.adderOption.include"
           constraints="gridbag(gridX=1;gridY=0;weightX=0.0;fill=none;anchor=west;insetsRight=3)" />
    <TextField name="adderName" data="data.adderOption.generatedName" columns="10" validateOnReturn="false"
           visible="data.adderOption.generateMode" enable="data.adderOption.include"
           constraints="gridbag(gridX=2;gridY=0;weightX=1.0;fill=horizontal;anchor=west)" />
    <Custom name="adderSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.adderOption.method" manageDynamicModel="true"
           visible="data.adderOption.attachMode" enable="data.adderOption.include"
           constraints="gridbag(gridX=2;gridY=0;weightX=1.0;fill=horizontal;anchor=west)">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.adderOption.candidates" />
    </Custom>
    <Label name="adderSummary" data="data.adderOption.summary" localize="false" align="left" font="SansSerif,2,10"
           constraints="gridbag(gridX=0;gridY=1;gridWidth=3;weightX=1.0;fill=horizontal;anchor=west;insetsTop=1)" />
  </Panel>

  <Label name="removerLabel" label="Remover:" localize="false" align="left"
         index="9" constraints="twocols(location=left)" />
  <Panel name="removerRow" layout="gridbag" border="empty"
         index="10" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="removerCB" data="data.removerOption.include"
           constraints="gridbag(gridX=0;gridY=0;weightX=0.0;fill=none;anchor=west;insetsRight=3)" />
    <DropDown name="removerMode" data="data.removerOption.mode" list="data.removerOption.availableModes"
           iteratorClassName="org.openflexo.pamela.editor.ui.action.AccessorOption$Mode"
           format="object.label" enable="data.removerOption.include"
           constraints="gridbag(gridX=1;gridY=0;weightX=0.0;fill=none;anchor=west;insetsRight=3)" />
    <TextField name="removerName" data="data.removerOption.generatedName" columns="10" validateOnReturn="false"
           visible="data.removerOption.generateMode" enable="data.removerOption.include"
           constraints="gridbag(gridX=2;gridY=0;weightX=1.0;fill=horizontal;anchor=west)" />
    <Custom name="removerSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.removerOption.method" manageDynamicModel="true"
           visible="data.removerOption.attachMode" enable="data.removerOption.include"
           constraints="gridbag(gridX=2;gridY=0;weightX=1.0;fill=horizontal;anchor=west)">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.removerOption.candidates" />
    </Custom>
    <Label name="removerSummary" data="data.removerOption.summary" localize="false" align="left" font="SansSerif,2,10"
           constraints="gridbag(gridX=0;gridY=1;gridWidth=3;weightX=1.0;fill=horizontal;anchor=west;insetsTop=1)" />
  </Panel>

  <Label name="reindexerLabel" label="Reindexer:" localize="false" align="left"
         index="11" constraints="twocols(location=left)" />
  <Panel name="reindexerRow" layout="gridbag" border="empty"
         index="12" constraints="twocols(expandHorizontally=true;location=right)">
    <CheckBox name="reindexerCB" data="data.reindexerOption.include"
           constraints="gridbag(gridX=0;gridY=0;weightX=0.0;fill=none;anchor=west;insetsRight=3)" />
    <DropDown name="reindexerMode" data="data.reindexerOption.mode" list="data.reindexerOption.availableModes"
           iteratorClassName="org.openflexo.pamela.editor.ui.action.AccessorOption$Mode"
           format="object.label" enable="data.reindexerOption.include"
           constraints="gridbag(gridX=1;gridY=0;weightX=0.0;fill=none;anchor=west;insetsRight=3)" />
    <TextField name="reindexerName" data="data.reindexerOption.generatedName" columns="10" validateOnReturn="false"
           visible="data.reindexerOption.generateMode" enable="data.reindexerOption.include"
           constraints="gridbag(gridX=2;gridY=0;weightX=1.0;fill=horizontal;anchor=west)" />
    <Custom name="reindexerSel" componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
           data="data.reindexerOption.method" manageDynamicModel="true"
           visible="data.reindexerOption.attachMode" enable="data.reindexerOption.include"
           constraints="gridbag(gridX=2;gridY=0;weightX=1.0;fill=horizontal;anchor=west)">
      <Assignment variable="component.entity" value="data.entity" />
      <Assignment variable="component.restrictedValues" value="data.reindexerOption.candidates" />
    </Custom>
    <Label name="reindexerSummary" data="data.reindexerOption.summary" localize="false" align="left" font="SansSerif,2,10"
           constraints="gridbag(gridX=0;gridY=1;gridWidth=3;weightX=1.0;fill=horizontal;anchor=west;insetsTop=1)" />
  </Panel>
</Panel>
