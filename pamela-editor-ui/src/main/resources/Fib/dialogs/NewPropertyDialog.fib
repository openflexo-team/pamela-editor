<?xml version="1.0" encoding="UTF-8"?>
<Panel dataClassName="org.openflexo.pamela.editor.ui.dialog.NewPropertyParameters"
       controllerClassName="org.openflexo.gina.controller.FIBController"
       layout="border" name="NewPropertyDialog"
       border="empty" borderTop="10" borderBottom="10" borderLeft="10" borderRight="10"
       width="420">

  <Panel name="form" layout="twocols" constraints="border(location=center)">
    <Label name="idLabel" label="Identifier" localize="false" align="left"
           index="0" constraints="twocols(location=left)" />
    <TextField name="idTF" data="data.identifier" columns="22" validateOnReturn="false"
           index="1" constraints="twocols(expandHorizontally=true;location=right)" />

    <Label name="listLabel" label="List (collection) property" localize="false" align="left"
           index="2" constraints="twocols(location=left)" />
    <CheckBox name="listCB" data="data.list"
           index="3" constraints="twocols(location=right)" />

    <Label name="typeLabel" label="Type" localize="false" align="left"
           index="4" constraints="twocols(location=left)" />
    <DropDown name="typeDD" data="data.type" list="data.typeChoices"
           iteratorClassName="java.lang.String" showReset="false" width="260"
           index="5" constraints="twocols(expandHorizontally=true;location=right)" />
  </Panel>

  <Panel name="buttons" layout="flow" align="right" constraints="border(location=south)">
    <Button name="cancelButton" label="cancel" buttonType="Trigger"
            action="controller.cancelAndDispose()" localize="true" />
    <Button name="okButton" label="ok" buttonType="Trigger" isDefault="true"
            action="controller.validateAndDispose()" enable="data.inputValid" localize="true" />
  </Panel>
</Panel>
