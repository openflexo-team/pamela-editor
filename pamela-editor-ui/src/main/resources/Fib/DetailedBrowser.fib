<?xml version="1.0" encoding="UTF-8"?>
<Panel id="0" font="SansSerif,0,11" darkLevel="0" useScrollBar="false" protectContent="false"
    height="100" name="main" layout="border"
    controllerClassName="org.openflexo.pamela.editor.ui.widget.DetailedBrowserFIBController"
    border="empty" trackViewPortWidth="true" width="250"
    dataClassName="java.lang.Object"
    trackViewPortHeight="true">

    <!--
        Single browser for all element types.
        root="data" with rootVisible="false": the selected element is the hidden
        root; its children are displayed as the top-level nodes.

        - SourceModelEntity  → shows its properties and initializers
        - SourcePackage       → shows its entities
        - PamelaClassDiagram  → shows its entity views
        - PamelaProject → shows packages + diagrams
        - null / other        → shows nothing (no matching BrowserElement)
    -->
    <Browser id="1" deepExploration="false" showFooter="false" rowHeight="18"
        showRootsHandle="true" root="data"
        selectionMode="SingleTreeSelection"
        doubleClickAction="controller.doubleClick(detailedBrowser.selected)"
        rightClickAction="controller.rightClick(detailedBrowser.selected,event)"
        useScrollBar="true" selected="controller.selectedElement"
        name="detailedBrowser" rootVisible="true" readOnly="false"
        iteratorClassName="java.lang.Object"
        constraints="border(location=center;x=0;y=0)">

        <!-- SourceMetaModel: shown when the user selects a session's metamodel node -->
        <BrowserElement id="5"
            icon="controller.iconForObject(metaModel)"
            filtered="false"
            label="metaModel.name"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourceMetaModel"
            name="metaModel"
            isEditable="false">
            <Children id="57" name="packages" data="metaModel.allPackages" />
        </BrowserElement>

        <BrowserElement id="10"
            icon="controller.iconForObject(project)"
            filtered="false"
            label="project.metaModel.name"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.ui.PamelaProject"
            name="project"
            isEditable="false">
            <!-- Diagrams appear only in the MetaModelBrowser, not in the DetailedBrowser. -->
            <Children id="51" name="packages" data="project.metaModel.allPackages" />
        </BrowserElement>

        <BrowserElement id="20"
            icon="controller.iconForObject(pkg)"
            filtered="false"
            label="pkg.qualifiedName"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourcePackage"
            name="pkg"
            isEditable="false">
            <Children id="52" name="members" data="pkg.members" />
        </BrowserElement>

        <BrowserElement id="90"
            icon="controller.iconForObject(javaFile)"
            filtered="false"
            label="javaFile.simpleName"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourceJavaFile"
            name="javaFile"
            isEditable="false">
        </BrowserElement>

        <BrowserElement id="30"
            icon="controller.iconForObject(entity)"
            filtered="false"
            label="entity.simpleName"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourceModelEntity"
            name="entity"
            isEditable="false">
            <Children id="53" name="properties" data="entity.declaredProperties.values()" />
            <Children id="54" name="initializers" data="entity.initializers" />
        </BrowserElement>

        <BrowserElement id="40"
            icon="controller.iconForObject(diagram)"
            filtered="false"
            label="diagram.name"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.diagram.PamelaClassDiagram"
            name="diagram"
            isEditable="false">
            <Children id="55" name="entityViews" data="diagram.entityViews" />
        </BrowserElement>

        <BrowserElement id="60"
            icon="controller.iconForObject(property)"
            filtered="false"
            label="property.propertyIdentifier"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourceModelProperty"
            name="property"
            isEditable="false">
        </BrowserElement>

        <BrowserElement id="70"
            icon="controller.iconForObject(initializer)"
            filtered="false"
            label="initializer.methodName"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourceModelInitializer"
            name="initializer"
            isEditable="false">
        </BrowserElement>

        <BrowserElement id="80"
            icon="controller.iconForObject(ev)"
            filtered="false"
            label="ev.qualifiedName"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.diagram.EntityView"
            name="ev"
            isEditable="false">
        </BrowserElement>

    </Browser>

</Panel>
