<?xml version="1.0" encoding="UTF-8"?>
<Panel dataClassName="org.openflexo.pamela.editor.ui.type.PamelaEntityTypeEditor"
       controllerClassName="org.openflexo.pamela.editor.ui.type.PamelaEntityBrowserController"
       layout="border" name="PamelaEntityTypeEditor" border="empty"
       width="320" height="260">

  <Browser root="data.metaModel" name="entityBrowser"
           iteratorClassName="java.lang.Object"
           selected="data.selectedElement" selectionMode="SingleTreeSelection"
           rootVisible="false" showFooter="false" rowHeight="18" readOnly="false"
           constraints="border(location=center)">

    <BrowserElement dataClassName="org.openflexo.pamela.editor.model.SourceMetaModel"
                    name="mm" label="mm.name" icon="controller.iconForObject(mm)">
      <Children name="packages" data="mm.allPackages" />
    </BrowserElement>

    <BrowserElement dataClassName="org.openflexo.pamela.editor.model.SourcePackage"
                    name="pkg" label="pkg.qualifiedName" icon="controller.iconForObject(pkg)">
      <Children name="entities" data="pkg.entities" />
    </BrowserElement>

    <BrowserElement dataClassName="org.openflexo.pamela.editor.model.SourceModelEntity"
                    name="entity" label="entity.simpleName" icon="controller.iconForObject(entity)" />
  </Browser>
</Panel>
