<?xml version="1.0" encoding="UTF-8"?>
<!--
  PackageSummaryView.fib
  Central view shown when a SourcePackage is selected.

  Layout (top → bottom):
    1. Header   — package icon 64×64 + qualified name, centred
    2. Entities — FlatDesign table: icon, name, implementation class,
                  properties/initializers/operations counts
    3. Spacer   — absorbs remaining vertical space so content stays top-aligned

  Statistics have moved to PackageStatisticsContextView.fib (ContextPanel, §19.2).
-->
<Panel id="0" font="SansSerif,0,11" darkLevel="0" useScrollBar="true" layout="twocols"
    height="600" name="PackageSummaryView"
    dataClassName="org.openflexo.pamela.editor.model.SourcePackage"
    controllerClassName="org.openflexo.pamela.editor.ui.widget.PackageSummaryViewFIBController"
    trackViewPortWidth="true" width="500"
    borderTop="0" borderLeft="0" borderBottom="0" borderRight="0" border="empty">

    <!-- ================================================================ -->
    <!-- 1. HEADER: package icon + qualified name, centred                -->
    <!-- ================================================================ -->
    <Panel id="10" layout="flow" flowAlignment="CENTER" hGap="12" vGap="10"
        border="empty" borderTop="5" borderLeft="10" borderBottom="5" borderRight="10"
        constraints="twocols(expandHorizontally=true;expandVertically=false;location=center)"
        name="HeaderPanel">
        <Image id="11" imageWidth="64" imageHeight="64" sizeAdjustment="OriginalSize"
            imageFile="../Icons/SourcePackage_64x64.png" align="center"
            constraints="flow()" name="PackageIcon" />
        <Label id="12" data="data.qualifiedName"
            font="SansSerif,1,18" align="left"
            constraints="flow()" name="PackageNameLabel" />
    </Panel>

    <!-- ================================================================ -->
    <!-- 2. ENTITIES table (FlatDesign, read-only)                        -->
    <!-- ================================================================ -->
    <Panel id="40" layout="twocols"
        border="empty" borderTop="0" borderLeft="10" borderBottom="4" borderRight="10"
        constraints="twocols(expandHorizontally=true;expandVertically=false;location=center)"
        name="EntitiesPanel">

        <Table id="42"
            lookAndFeel="FlatDesign"
            data="data.entities"
            iteratorClassName="org.openflexo.pamela.editor.model.SourceModelEntity"
            visibleRowCount="8"
            rowHeight="18"
            showHeader="true"
            showFooter="false"
            selectionMode="SingleSelection"
            backgroundSelectionColor="9,80,208"
            backgroundNonSelectionColor="255,255,255"
            backgroundSecondarySelectionColor="178,215,255"
            textSelectionColor="255,255,255"
            textNonSelectionColor="0,0,0"
            textSecondarySelectionColor="0,0,0"
            manageDynamicModel="true"
            constraints="twocols(expandHorizontally=true;expandVertically=false;location=center)"
            name="EntitiesTable">
            <IconColumn id="43" data="controller.iconForObject(iterator)"
                title="" displayTitle="false" columnWidth="20" resizable="false" name="EntityIcon" />
            <TextFieldColumn id="44" data="iterator.simpleName"
                title="name" displayTitle="true" resizable="true" columnWidth="200"
                showIcon="false" readOnly="true" name="EntityName" />
            <TextFieldColumn id="57" data="(iterator.implementationClass != null ? iterator.implementationClass.simpleName : &quot;&quot;)"
                title="implementation_class" displayTitle="true" resizable="true" columnWidth="150"
                showIcon="false" readOnly="true" name="EntityImplementationClass" />
            <TextFieldColumn id="46" data="iterator.declaredProperties.size.toString"
                title="properties" displayTitle="true" resizable="false" columnWidth="70"
                showIcon="false" readOnly="true" name="EntityPropertiesCount" />
            <TextFieldColumn id="55" data="iterator.initializers.size.toString"
                title="initializers" displayTitle="true" resizable="false" columnWidth="70"
                showIcon="false" readOnly="true" name="EntityInitializersCount" />
            <TextFieldColumn id="56" data="iterator.declaredCustomMethods.size.toString"
                title="operations" displayTitle="true" resizable="false" columnWidth="70"
                showIcon="false" readOnly="true" name="EntityOperationsCount" />
        </Table>

    </Panel>

    <!-- ================================================================ -->
    <!-- 3. SPACER: absorbs remaining vertical space so content stays top -->
    <!-- ================================================================ -->
    <Spacer id="60"
        constraints="twocols(expandHorizontally=true;expandVertically=true;location=center)"
        name="BottomSpacer" />

    <LocalizedDictionary id="90">
        <Localized id="97" lang="English" value="Name"      key="name" />
        <Localized id="98" lang="French"  value="Nom"       key="name" />
        <Localized id="101" lang="English" value="Properties"          key="properties" />
        <Localized id="102" lang="French"  value="Propriétés"          key="properties" />
        <Localized id="103" lang="English" value="Initializers"        key="initializers" />
        <Localized id="104" lang="French"  value="Initialiseurs"       key="initializers" />
        <Localized id="105" lang="English" value="Operations"          key="operations" />
        <Localized id="106" lang="French"  value="Opérations"          key="operations" />
        <Localized id="107" lang="English" value="Implementation class" key="implementation_class" />
        <Localized id="108" lang="French"  value="Classe d'implémentation" key="implementation_class" />
    </LocalizedDictionary>

</Panel>
