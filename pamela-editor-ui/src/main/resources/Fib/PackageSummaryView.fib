<?xml version="1.0" encoding="UTF-8"?>
<!-- Summary view for SourcePackage (shown in central tab when a package is selected) -->
<Panel id="0" darkLevel="0" useScrollBar="true" layout="twocols"
    height="400" name="PackageSummaryView"
    dataClassName="org.openflexo.pamela.editor.model.SourcePackage"
    trackViewPortWidth="true" width="400">

    <Label id="1" label="Package summary" constraints="twocols(isLabel=true;expandHorizontally=false;expandVertically=false)" />

    <Label id="2" label="Qualified name" constraints="twocols(isLabel=true;expandHorizontally=false;expandVertically=false)" />
    <TextField id="3" data="data.qualifiedName" readOnly="true"
        constraints="twocols(isLabel=false;expandHorizontally=true;expandVertically=false)" />

    <Label id="4" label="Entities" constraints="twocols(isLabel=true;expandHorizontally=false;expandVertically=false)" />
    <TextField id="5" data="data.entities.size" readOnly="true"
        constraints="twocols(isLabel=false;expandHorizontally=false;expandVertically=false)" />

</Panel>
