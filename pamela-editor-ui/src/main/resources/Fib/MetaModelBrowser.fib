<?xml version="1.0" encoding="UTF-8"?>
<Panel id="0" font="SansSerif,0,11" darkLevel="0" useScrollBar="false" protectContent="false"
    height="400" name="main" layout="border"
    controllerClassName="org.openflexo.pamela.editor.ui.widget.MetaModelBrowserFIBController"
    border="empty" trackViewPortWidth="true" width="250"
    dataClassName="org.openflexo.pamela.editor.ui.PamelaEditorApplication"
    trackViewPortHeight="true">
    <Browser id="1" deepExploration="true" showFooter="false" rowHeight="18"
        showRootsHandle="true" root="data"
        allowsExternalDragAndDrop="true"
        selectionMode="SingleTreeSelection"
        doubleClickAction="controller.doubleClick(metaModelBrowser.selected)"
        rightClickAction="controller.rightClick(metaModelBrowser.selected,event)"
        useScrollBar="true" selected="controller.selectedElement"
        name="metaModelBrowser" rootVisible="false" readOnly="false"
        iteratorClassName="java.lang.Object"
        constraints="border(location=center;x=0;y=0)">

        <BrowserElement id="2"
            icon="controller.iconForObject(app)"
            filtered="false"
            label="app.class.simpleName"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.ui.PamelaEditorApplication"
            name="app"
            isEditable="false">
            <Children id="9" name="projects" data="app.projects" />
        </BrowserElement>

        <BrowserElement id="3"
            icon="controller.iconForObject(project)"
            filtered="false"
            label="project.metaModel.name+&quot;.pamela&quot;"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.ui.PamelaProject"
            name="project"
            isEditable="false">
            <Children id="10" name="diagrams" data="project.diagrams" />
            <Children id="13" name="sourceFolders" data="project.metaModel.sourceFolders" />
        </BrowserElement>

        <BrowserElement id="4"
            icon="controller.iconForObject(diagram)"
            filtered="false"
            label="diagram.name+&quot;.diagram&quot;"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.diagram.PamelaClassDiagram"
            name="diagram"
            isEditable="false">
        </BrowserElement>

        <BrowserElement id="8"
            icon="controller.iconForObject(folder)"
            filtered="false"
            label="folder.name"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourceFolder"
            name="folder"
            isEditable="false">
            <Children id="14" name="packages" data="folder.packages" />
        </BrowserElement>

        <BrowserElement id="5"
            icon="controller.iconForObject(pkg)"
            filtered="false"
            label="pkg.qualifiedName"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourcePackage"
            name="pkg"
            isEditable="false">
            <Children id="12" name="members" data="pkg.members" />
        </BrowserElement>

        <BrowserElement id="6"
            icon="controller.iconForObject(entity)"
            filtered="false"
            label="controller.labelForEntity(entity)"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourceModelEntity"
            name="entity"
            isEditable="false">
        </BrowserElement>

        <BrowserElement id="7"
            icon="controller.iconForObject(javaFile)"
            filtered="false"
            label="controller.labelForJavaFile(javaFile)"
            defaultVisible="true"
            dataClassName="org.openflexo.pamela.editor.model.SourceJavaFile"
            name="javaFile"
            isEditable="false">
        </BrowserElement>
         <!--  enabled="false" -->
 
    </Browser>
</Panel>
