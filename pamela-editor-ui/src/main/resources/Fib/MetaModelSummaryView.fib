<?xml version="1.0" encoding="UTF-8"?>
<!--
  MetaModelSummaryView.fib
  Central view shown when a SourceMetaModel or PamelaProject is selected.

  Layout (top → bottom):
    1. Header     — icon 64×64 + model name, centred
    2. Definition — source directories table + root types table (no decoration)
    3. Statistics — read-only metrics in rounded3d titled panel, twocols key/value
-->
<Panel id="0" darkLevel="0" useScrollBar="true" layout="twocols"
    height="600" name="MetaModelSummaryView"
    dataClassName="org.openflexo.pamela.editor.model.SourceMetaModel"
    controllerClassName="org.openflexo.pamela.editor.ui.widget.MetaModelSummaryViewFIBController"
    trackViewPortWidth="true" width="500"
    borderTop="0" borderLeft="0" borderBottom="0" borderRight="0" border="empty">

    <!-- ================================================================ -->
    <!-- 1. HEADER: icon + name, centred                                  -->
    <!-- ================================================================ -->
    <Panel id="10" layout="flow" flowAlignment="CENTER" hGap="12" vGap="10"
        border="empty" borderTop="5" borderLeft="10" borderBottom="5" borderRight="10"
        constraints="twocols(expandHorizontally=true;expandVertically=false;location=center)"
        name="HeaderPanel">
        <Image id="11" imageWidth="64" imageHeight="64" sizeAdjustment="OriginalSize"
            imageFile="../Icons/PamelaModel_64x64.png" align="center"
            constraints="flow()" name="MetaModelIcon" />
        <Label id="12" data="data.name"
            font="SansSerif,1,22" align="left"
            constraints="flow()" name="MetaModelNameLabel" />
    </Panel>

    <!-- ================================================================ -->
    <!-- 2. MODEL DEFINITION: source dirs + root types (no decoration)    -->
    <!-- ================================================================ -->
    <Panel id="40" layout="twocols"
        border="empty" borderTop="0" borderLeft="10" borderBottom="4" borderRight="10"
        constraints="twocols(expandHorizontally=true;expandVertically=false;location=center)"
        name="ModelDefinitionPanel">

        <!-- Source directories sub-title -->
        <Label id="42" label="source_directories" align="left" localize="true"
            font="SansSerif,1,12"
            constraints="twocols(expandHorizontally=true;expandVertically=false;location=center;insetsBottom=3)"
            name="SourceDirectoriesLabel" />

        <!-- Source directories table (FlatDesign, editable) -->
        <Table id="43"
            lookAndFeel="FlatDesign"
            data="data.sourceDirectories"
            iteratorClassName="java.io.File"
            visibleRowCount="4"
            rowHeight="22"
            showHeader="true"
            showFooter="true"
            selectionMode="SingleSelection"
            backgroundSelectionColor="9,80,208"
            backgroundNonSelectionColor="255,255,255"
            backgroundSecondarySelectionColor="178,215,255"
            textSelectionColor="255,255,255"
            textNonSelectionColor="0,0,0"
            textSecondarySelectionColor="0,0,0"
            manageDynamicModel="true"
            constraints="twocols(expandHorizontally=true;expandVertically=false;location=center)"
            name="SourceDirectoriesTable">
            <IconColumn id="53" data="controller.getSourceFolderIcon(iterator)"
                title="" displayTitle="false" columnWidth="20" name="SourceDirIcon" resizable="false"/>
            <TextFieldColumn id="44" data="iterator.absolutePath"
                title="path" displayTitle="true" resizable="true" columnWidth="300"
                showIcon="false" readOnly="true" name="SourceDirPath" />
            <AddAction id="45" method="controller.addSourceDirectory()"
                name="add_source_dir" />
            <RemoveAction id="46"
                method="controller.removeSourceDirectory(selected)"
                isAvailable="selected != null"
                name="remove_source_dir" />
        </Table>

        <!-- Root types sub-title -->
        <Label id="47" label="root_types" align="left" localize="true"
            font="SansSerif,1,12"
            constraints="twocols(expandHorizontally=true;expandVertically=false;location=center;insetsTop=10;insetsBottom=3)"
            name="RootTypesLabel" />

        <!-- Root types table (FlatDesign, editable) -->
        <Table id="48"
            lookAndFeel="FlatDesign"
            data="data.rootTypeNames"
            iteratorClassName="java.lang.String"
            visibleRowCount="5"
            rowHeight="22"
            showHeader="true"
            showFooter="true"
            selectionMode="SingleSelection"
            backgroundSelectionColor="9,80,208"
            backgroundNonSelectionColor="255,255,255"
            backgroundSecondarySelectionColor="178,215,255"
            textSelectionColor="255,255,255"
            textNonSelectionColor="0,0,0"
            textSecondarySelectionColor="0,0,0"
            manageDynamicModel="true"
            constraints="twocols(expandHorizontally=true;expandVertically=false;location=center)"
            name="RootTypesTable">
            <IconColumn id="54" data="controller.getRootTypeIcon(iterator)"
                title="" displayTitle="false" columnWidth="20" name="RootTypeIcon" resizable="false"/>
            <TextFieldColumn id="49" data="iterator"
                title="qualified_name" displayTitle="true" resizable="true" columnWidth="300"
                showIcon="false" readOnly="true" name="RootTypeName" />
            <AddAction id="50" method="controller.addRootTypeName()"
                name="add_root_type" />
            <RemoveAction id="51"
                method="controller.removeRootTypeName(selected)"
                isAvailable="selected != null"
                name="remove_root_type" />
        </Table>

    </Panel>

    <!-- ================================================================ -->
    <!-- 3. STATISTICS — rounded3d with title, grid 4 cols × 3 rows      -->
    <!--    col0: label | col1: value | col2: label | col3: value        -->
    <!-- ================================================================ -->
    <Panel id="20" layout="grid" cols="4" rows="3" hGap="6" vGap="4"
        border="rounded3d" borderTitle="statistics"
        borderTop="12" borderLeft="8" borderBottom="8" borderRight="8"
        constraints="twocols(expandHorizontally=true;expandVertically=false;location=center;insetsTop=10;insetsBottom=10;insetsLeft=10;insetsRight=10)"
        name="StatisticsPanel">

        <!-- Row 0: packages | value | properties | value -->
        <Label id="22" label="packages" align="right" localize="true"
            constraints="grid(x=0;y=0)" name="PackagesLabel" />
        <TextField id="23" data="data.packagesCount.toString" readOnly="true" columns="4"
            constraints="grid(x=1;y=0)" name="PackagesValue" />
        <Label id="24" label="properties" align="right" localize="true"
            constraints="grid(x=2;y=0)" name="PropertiesLabel" />
        <TextField id="25" data="data.totalPropertiesCount.toString" readOnly="true" columns="4"
            constraints="grid(x=3;y=0)" name="PropertiesValue" />

        <!-- Row 1: entities | value | initializers | value -->
        <Label id="26" label="entities" align="right" localize="true"
            constraints="grid(x=0;y=1)" name="EntitiesLabel" />
        <TextField id="27" data="data.entitiesCount.toString" readOnly="true" columns="4"
            constraints="grid(x=1;y=1)" name="EntitiesValue" />
        <Label id="28" label="initializers" align="right" localize="true"
            constraints="grid(x=2;y=1)" name="InitializersLabel" />
        <TextField id="29" data="data.totalInitializersCount.toString" readOnly="true" columns="4"
            constraints="grid(x=3;y=1)" name="InitializersValue" />

        <!-- Row 2: abstract entities | value | issues | value -->
        <Label id="30" label="abstract_entities" align="right" localize="true"
            constraints="grid(x=0;y=2)" name="AbstractLabel" />
        <TextField id="31" data="data.abstractEntitiesCount.toString" readOnly="true" columns="4"
            constraints="grid(x=1;y=2)" name="AbstractValue" />
        <Label id="32" label="issues" align="right" localize="true"
            constraints="grid(x=2;y=2)" name="IssuesLabel" />
        <TextField id="33" data="data.issuesCount.toString" readOnly="true" columns="4"
            constraints="grid(x=3;y=2)" name="IssuesValue" />

    </Panel>

    <LocalizedDictionary id="90">
        <Localized id="91"  lang="English" value="Statistics"          key="statistics" />
        <Localized id="92"  lang="French"  value="Statistiques"        key="statistics" />
        <Localized id="93"  lang="English" value="Packages"            key="packages" />
        <Localized id="94"  lang="French"  value="Packages"            key="packages" />
        <Localized id="95"  lang="English" value="Entities"            key="entities" />
        <Localized id="96"  lang="French"  value="Entités"             key="entities" />
        <Localized id="97"  lang="English" value="Abstract entities"   key="abstract_entities" />
        <Localized id="98"  lang="French"  value="Entités abstraites"  key="abstract_entities" />
        <Localized id="99"  lang="English" value="Properties"          key="properties" />
        <Localized id="100" lang="French"  value="Propriétés"          key="properties" />
        <Localized id="101" lang="English" value="Initializers"        key="initializers" />
        <Localized id="102" lang="French"  value="Initialiseurs"       key="initializers" />
        <Localized id="103" lang="English" value="Issues"              key="issues" />
        <Localized id="104" lang="French"  value="Problèmes"           key="issues" />
        <Localized id="107" lang="English" value="Source directories"  key="source_directories" />
        <Localized id="108" lang="French"  value="Répertoires sources" key="source_directories" />
        <Localized id="109" lang="English" value="Root types"          key="root_types" />
        <Localized id="110" lang="French"  value="Types racines"       key="root_types" />
        <Localized id="111" lang="English" value="Path"                key="path" />
        <Localized id="112" lang="French"  value="Chemin"              key="path" />
        <Localized id="113" lang="English" value="Qualified name"      key="qualified_name" />
        <Localized id="114" lang="French"  value="Nom qualifié"        key="qualified_name" />
    </LocalizedDictionary>

</Panel>
