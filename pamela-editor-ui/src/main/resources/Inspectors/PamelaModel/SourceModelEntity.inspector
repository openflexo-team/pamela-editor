<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="border" darkLevel="0" font="SansSerif,0,11"
    dataClassName="org.openflexo.pamela.editor.model.SourceModelEntity"
    controllerClassName="org.openflexo.pamela.editor.ui.widget.PamelaModelInspectorFIBController"
    name="Inspector">
    <TabPanel name="Tab" index="0" constraints="border(location=center)">
        <Tab title="basic" layout="twocols" name="BasicTab" index="0" localize="true">
            <Label name="SimpleNameLabel" label="entity_label" index="0"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="SimpleNameTF" index="1" data="data.simpleName" readOnly="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="15" localize="true" />
            <Label name="QualifiedNameLabel" label="qualified_name" index="2"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="QualifiedNameTF" index="3" data="data.qualifiedName" readOnly="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="15" localize="true" />
            <Label name="PackageLabel" label="package" index="4"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="PackageTF" index="5" data="data.sourcePackage.qualifiedName" readOnly="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="15" localize="true" />
            <Label name="AbstractLabel" label="abstract" index="6"
                constraints="twocols(location=left)" localize="true" />
            <CheckBox name="AbstractCB" index="7" data="data.abstract" readOnly="false"
                constraints="twocols(location=right)" localize="true" />
            <Label name="SuperEntitiesLabel" label="super_entities" index="8"
                constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" localize="true" />
            <Table name="SuperEntitiesTable" iteratorClassName="org.openflexo.pamela.editor.model.SourceModelEntity"
                lookAndFeel="FlatDesign" showHeader="false" autoSelectFirstRow="false"
                createNewRowOnClick="false" showFooter="true" selectionMode="SingleSelection"
                localize="true" manageDynamicModel="true" opaque="false" index="9"
                data="data.directSuperEntities"
                constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)">
                <IconColumn name="icon" data="controller.iconForObject(iterator)"
                    title="icon" columnWidth="25" resizable="false" displayTitle="false" />
                <LabelColumn name="label" data="iterator.simpleName"
                    title="entity" columnWidth="120" resizable="true" displayTitle="true" />
                <RemoveAction name="delete" method="data.unlinkSuperEntity(selected)" />
                <AddAction name="add_super_entity" method="data.requestAddSuperEntity()" />
            </Table>
            <Panel name="Spacer" layout="flow" index="10"
                constraints="twocols(expandHorizontally=true;expandVertically=true;location=center)" />
        </Tab>
        <Tab title="advanced" layout="twocols" name="AdvancedTab" index="1" localize="true">
            <Label name="InitPolicyLabel" label="init_policy" index="0"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="InitPolicyTF" index="1" data="data.initPolicy.name" readOnly="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="10" localize="true" />
            <Label name="IdStyleLabel" label="identifier_style" index="2"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="IdStyleTF" index="3" data="data.identifierStyle.name" readOnly="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="12" localize="true" />
            <Label name="ImportsLabel" label="imports" index="4"
                constraints="twocols(expandHorizontally=false;expandVertically=false;location=left)" localize="true" />
            <Table name="ImportsTable" iteratorClassName="org.openflexo.pamela.editor.model.SourceModelEntity"
                lookAndFeel="FlatDesign" showHeader="false" autoSelectFirstRow="false"
                createNewRowOnClick="false" showFooter="true" selectionMode="SingleSelection"
                localize="true" manageDynamicModel="true" opaque="false" index="5"
                data="data.importedEntities"
                constraints="twocols(expandHorizontally=true;expandVertically=false;location=right)">
                <IconColumn name="icon" data="controller.iconForObject(iterator)"
                    title="icon" columnWidth="25" resizable="false" displayTitle="false" />
                <LabelColumn name="label" data="iterator.simpleName"
                    title="entity" columnWidth="120" resizable="true" displayTitle="true" />
                <RemoveAction name="delete" method="data.unlinkImport(selected)" />
                <AddAction name="add_import" method="data.requestAddImport()" />
            </Table>
            <Panel name="Spacer" layout="flow" index="6"
                constraints="twocols(expandHorizontally=true;expandVertically=true;location=center)" />
        </Tab>
    </TabPanel>
    <LocalizedDictionary>
        <Localized key="basic" lang="English" value="Basic" />
        <Localized key="basic" lang="French" value="Basique" />
        <Localized key="entity_label" lang="English" value="Entity" />
        <Localized key="entity_label" lang="French" value="Entité" />
        <Localized key="advanced" lang="English" value="Advanced" />
        <Localized key="advanced" lang="French" value="Avancé" />
        <Localized key="simple_name" lang="English" value="Simple name" />
        <Localized key="simple_name" lang="French" value="Nom simple" />
        <Localized key="qualified_name" lang="English" value="Qualified name" />
        <Localized key="qualified_name" lang="French" value="Nom qualifié" />
        <Localized key="package" lang="English" value="Package" />
        <Localized key="package" lang="French" value="Package" />
        <Localized key="abstract" lang="English" value="Abstract" />
        <Localized key="abstract" lang="French" value="Abstrait" />
        <Localized key="init_policy" lang="English" value="Init policy" />
        <Localized key="init_policy" lang="French" value="Politique d&apos;initialisation" />
        <Localized key="identifier_style" lang="English" value="Identifier style" />
        <Localized key="identifier_style" lang="French" value="Style d&apos;identifiant" />
        <Localized key="properties" lang="English" value="Properties" />
        <Localized key="properties" lang="French" value="Propriétés" />
        <Localized key="super_entities" lang="English" value="Super entities" />
        <Localized key="super_entities" lang="French" value="Super entités" />
        <Localized key="name" lang="English" value="Name" />
        <Localized key="name" lang="French" value="Nom" />
        <Localized key="add_super_entity" lang="English" value="Add" />
        <Localized key="add_super_entity" lang="French" value="Ajouter" />
        <Localized key="imports" lang="English" value="Imports" />
        <Localized key="imports" lang="French" value="Imports" />
        <Localized key="add_import" lang="English" value="Add" />
        <Localized key="add_import" lang="French" value="Ajouter" />
    </LocalizedDictionary>
    <Parameter name="title" value="Entity" />
</Inspector>
