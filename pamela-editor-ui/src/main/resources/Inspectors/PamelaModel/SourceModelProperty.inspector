<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="twocols" darkLevel="0" font="SansSerif,0,11"
    dataClassName="org.openflexo.pamela.editor.model.SourceModelProperty" name="Inspector">
    <Label name="IdentifierLabel" label="identifier" index="0"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="IdentifierTF" index="1" data="data.propertyIdentifier" readOnly="true"
        constraints="twocols(expandHorizontally=true;location=right)" columns="15" localize="true" />
    <Label name="CardinalityLabel" label="cardinality" index="2"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="CardinalityTF" index="3" data="data.cardinality.name" readOnly="true"
        constraints="twocols(location=right)" columns="8" localize="true" />
    <Label name="TypeLabel" label="type" index="4"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="TypeTF" index="5" data="data.type.simpleName" readOnly="true"
        constraints="twocols(expandHorizontally=true;location=right)" columns="15" localize="true" />

    <Label name="DefaultValueLabel" label="default_value" index="6"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="DefaultValueTF" index="7" data="data.defaultValue" readOnly="false"
        validateOnReturn="true"
        constraints="twocols(expandHorizontally=true;location=right)" columns="15" localize="true" />
    <Label name="DerivedLabel" label="derived" index="8"
        constraints="twocols(location=left)" localize="true" />
    <CheckBox name="DerivedCB" index="9" data="data.derived" readOnly="false"
        constraints="twocols(location=right)" localize="true" />
    <Label name="EmbeddedLabel" label="embedded" index="10"
        constraints="twocols(location=left)" localize="true" />
    <CheckBox name="EmbeddedCB" index="11" data="data.embedded" readOnly="false"
        constraints="twocols(location=right)" localize="true" />
    <Label name="IgnoreTypeLabel" label="ignore_type" index="12"
        constraints="twocols(location=left)" localize="true" />
    <CheckBox name="IgnoreTypeCB" index="13" data="data.ignoreType" readOnly="false"
        constraints="twocols(location=right)" localize="true" />
    <Label name="IgnoreEqualityLabel" label="ignore_for_equality" index="14"
        constraints="twocols(location=left)" localize="true" />
    <CheckBox name="IgnoreEqualityCB" index="15" data="data.ignoreForEquality" readOnly="false"
        constraints="twocols(location=right)" localize="true" />
    <Label name="AllowsMultipleLabel" label="allows_multiple" index="16"
        constraints="twocols(location=left)" localize="true" />
    <CheckBox name="AllowsMultipleCB" index="17" data="data.allowsMultipleOccurrences" readOnly="false"
        constraints="twocols(location=right)" localize="true" />

    <Label name="GetterLabel" label="getter" index="18"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="GetterTF" index="19" data="data.getterMethodName" readOnly="true"
        constraints="twocols(expandHorizontally=true;location=right)" columns="15" localize="true" />
    <Label name="SetterLabel" label="setter" index="20"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="SetterTF" index="21" data="data.setterMethodName" readOnly="true"
        constraints="twocols(expandHorizontally=true;location=right)" columns="15" localize="true" />
    <Label name="InverseLabel" label="inverse" index="22"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="InverseTF" index="23" data="data.inversePropertyIdentifier" readOnly="true"
        constraints="twocols(expandHorizontally=true;location=right)" columns="15" localize="true" />
    <LocalizedDictionary>
        <Localized key="identifier" lang="English" value="Identifier" />
        <Localized key="identifier" lang="French" value="Identifiant" />
        <Localized key="cardinality" lang="English" value="Cardinality" />
