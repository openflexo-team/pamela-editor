<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="border" darkLevel="0" font="SansSerif,0,11"
    dataClassName="org.openflexo.pamela.editor.model.SourceModelProperty" name="Inspector">
    <TabPanel name="Tab" index="0" constraints="border(location=center)">

        <Tab title="basic" layout="twocols" name="BasicTab" index="0" localize="true">
            <Label name="IdentifierLabel" label="property_label" index="0"
                constraints="twocols(location=left)" localize="true" />

            <Panel name="IdentifierRow" layout="border" flowAlignment="LEFT" hGap="0" vGap="0" border="empty" index="1"
                constraints="twocols(expandHorizontally=true;location=right)">
                <TextField name="IdentifierTF" data="data.propertyIdentifier" readOnly="true"
                    columns="13" localize="true" constraints="border(location=center)" />
                <Button name="RenameBtn" buttonType="Trigger" label="rename_button" constraints="border(location=east)" localize="true"
                    action="data.requestRename()" />
            </Panel>

            <Label name="CardinalityLabel" label="cardinality" index="2"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="CardinalityTF" index="3" data="data.cardinality.name" readOnly="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" localize="true" />

            <Label name="TypeLabel" label="type" index="4"
                constraints="twocols(location=left)" localize="true" />
            <Panel name="TypeRow" layout="border" flowAlignment="LEFT" hGap="0" vGap="0" border="empty" index="5"
                constraints="twocols(expandHorizontally=true;location=right)">
                <TextField name="TypeTF" data="data.type.simpleName" readOnly="true"
                    columns="13" localize="true" constraints="border(location=center)" />
                <Button name="ChangeTypeBtn" buttonType="Trigger" label="change_type_button" constraints="border(location=east)" localize="true"
                    action="data.requestChangeType()" />
            </Panel>

            <Label name="DefaultValueLabel" label="default_value" index="6"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="DefaultValueTF" index="7" data="data.defaultValue" readOnly="false"
                validateOnReturn="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="15" localize="true" />

            <Label name="InverseLabel" label="inverse" index="8"
                constraints="twocols(location=left)" localize="true" />
            <Custom name="InverseSelector"
                componentClassName="org.openflexo.pamela.editor.ui.widget.ModelPropertySelector"
                data="data.inverse" manageDynamicModel="true" index="9"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)">
                <Assignment variable="component.entity" value="data.type.modelEntity" />
            </Custom>

            <Label name="EmbeddedLabel" label="embedded" index="10"
                constraints="twocols(location=left)" localize="true" />
            <CheckBox name="EmbeddedCB" index="11" data="data.embedded" readOnly="false"
                constraints="twocols(location=right)" localize="true" />
            <Panel name="Spacer" layout="flow" index="12"
                constraints="twocols(expandHorizontally=true;expandVertically=true;location=center)" />
        </Tab>

        <Tab title="accessors" layout="twocols" name="AccessorsTab" index="1" localize="true">
            <!-- Getter — mandatory, no checkbox; the selector shows the getter (read-only). -->
            <Label name="GetterLabel" label="getter" index="0"
                constraints="twocols(location=left)" localize="true" />
            <Custom name="GetterSelector" index="1"
                componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
                data="data.getterMethod" manageDynamicModel="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)">
                <Assignment variable="component.entity" value="data.modelEntity" />
            </Custom>

            <!-- Setter (SINGLE) — checkbox declares/undeclares; selector picks the method. -->
            <Label name="SetterLabel" label="setter" index="2" visible="data.singleCardinality"
                constraints="twocols(location=left)" localize="true" />
            <Panel name="SetterRow" layout="border" border="empty" hGap="3" vGap="0" index="3"
                visible="data.singleCardinality"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)">
                <CheckBox name="SetterCB" data="data.setterPresent" constraints="border(location=west)" />
                <Custom name="SetterSelector"
                    componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
                    data="data.setterMethod" manageDynamicModel="true" enable="data.setterPresent"
                    constraints="border(location=center)">
                    <Assignment variable="component.entity" value="data.modelEntity" />
                    <Assignment variable="component.restrictedValues" value="data.setterCandidates" />
                </Custom>
            </Panel>

            <!-- Updater (SINGLE) -->
            <Label name="UpdaterLabel" label="updater" index="4" visible="data.singleCardinality"
                constraints="twocols(location=left)" localize="true" />
            <Panel name="UpdaterRow" layout="border" border="empty" hGap="3" vGap="0" index="5"
                visible="data.singleCardinality"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)">
                <CheckBox name="UpdaterCB" data="data.updaterPresent" constraints="border(location=west)" />
                <Custom name="UpdaterSelector"
                    componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
                    data="data.updaterMethod" manageDynamicModel="true" enable="data.updaterPresent"
                    constraints="border(location=center)">
                    <Assignment variable="component.entity" value="data.modelEntity" />
                    <Assignment variable="component.restrictedValues" value="data.updaterCandidates" />
                </Custom>
            </Panel>

            <!-- Adder (LIST) -->
            <Label name="AdderLabel" label="adder" index="6" visible="data.listCardinality"
                constraints="twocols(location=left)" localize="true" />
            <Panel name="AdderRow" layout="border" border="empty" hGap="3" vGap="0" index="7"
                visible="data.listCardinality"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)">
                <CheckBox name="AdderCB" data="data.adderPresent" constraints="border(location=west)" />
                <Custom name="AdderSelector"
                    componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
                    data="data.adderMethod" manageDynamicModel="true" enable="data.adderPresent"
                    constraints="border(location=center)">
                    <Assignment variable="component.entity" value="data.modelEntity" />
                    <Assignment variable="component.restrictedValues" value="data.adderCandidates" />
                </Custom>
            </Panel>

            <!-- Remover (LIST) -->
            <Label name="RemoverLabel" label="remover" index="8" visible="data.listCardinality"
                constraints="twocols(location=left)" localize="true" />
            <Panel name="RemoverRow" layout="border" border="empty" hGap="3" vGap="0" index="9"
                visible="data.listCardinality"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)">
                <CheckBox name="RemoverCB" data="data.removerPresent" constraints="border(location=west)" />
                <Custom name="RemoverSelector"
                    componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
                    data="data.removerMethod" manageDynamicModel="true" enable="data.removerPresent"
                    constraints="border(location=center)">
                    <Assignment variable="component.entity" value="data.modelEntity" />
                    <Assignment variable="component.restrictedValues" value="data.removerCandidates" />
                </Custom>
            </Panel>

            <!-- Reindexer (LIST) -->
            <Label name="ReindexerLabel" label="reindexer" index="10" visible="data.listCardinality"
                constraints="twocols(location=left)" localize="true" />
            <Panel name="ReindexerRow" layout="border" border="empty" hGap="3" vGap="0" index="11"
                visible="data.listCardinality"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)">
                <CheckBox name="ReindexerCB" data="data.reindexerPresent" constraints="border(location=west)" />
                <Custom name="ReindexerSelector"
                    componentClassName="org.openflexo.pamela.editor.ui.widget.JavaMethodSelector"
                    data="data.reindexerMethod" manageDynamicModel="true" enable="data.reindexerPresent"
                    constraints="border(location=center)">
                    <Assignment variable="component.entity" value="data.modelEntity" />
                    <Assignment variable="component.restrictedValues" value="data.reindexerCandidates" />
                </Custom>
            </Panel>
            <Panel name="Spacer" layout="flow" index="12"
                constraints="twocols(expandHorizontally=true;expandVertically=true;location=center)" />
        </Tab>

        <Tab title="advanced" layout="twocols" name="AdvancedTab" index="2" localize="true">
            <Label name="DerivedLabel" label="derived" index="0"
                constraints="twocols(location=left)" localize="true" />
            <CheckBox name="DerivedCB" index="1" data="data.derived" readOnly="false"
                constraints="twocols(location=right)" localize="true" />
            <Label name="IgnoreTypeLabel" label="ignore_type" index="2"
                constraints="twocols(location=left)" localize="true" />
            <CheckBox name="IgnoreTypeCB" index="3" data="data.ignoreType" readOnly="false"
                constraints="twocols(location=right)" localize="true" />
            <Label name="IgnoreEqualityLabel" label="ignore_for_equality" index="4"
                constraints="twocols(location=left)" localize="true" />
            <CheckBox name="IgnoreEqualityCB" index="5" data="data.ignoreForEquality" readOnly="false"
                constraints="twocols(location=right)" localize="true" />
            <Label name="AllowsMultipleLabel" label="allows_multiple" index="6"
                constraints="twocols(location=left)" localize="true" />
            <CheckBox name="AllowsMultipleCB" index="7" data="data.allowsMultipleOccurrences" readOnly="false"
                constraints="twocols(location=right)" localize="true" />
            <Label name="IdStyleLabel" label="identifier_style" index="8"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="IdStyleTF" index="9" data="data.identifierStyle.name" readOnly="true"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="12" localize="true" />
            <Label name="ConstantNameLabel" label="constant_name" index="10"
                visible="data.referencedConstantName != null"
                constraints="twocols(location=left)" localize="true" />
            <TextField name="ConstantNameTF" index="11" data="data.referencedConstantName" readOnly="true"
                visible="data.referencedConstantName != null"
                constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="12" localize="true" />
            <Panel name="Spacer" layout="flow" index="12"
                constraints="twocols(expandHorizontally=true;expandVertically=true;location=center)" />
        </Tab>

    </TabPanel>

    <LocalizedDictionary>
        <Localized key="basic" lang="English" value="Basic" />
        <Localized key="basic" lang="French" value="Basique" />
        <Localized key="property_label" lang="English" value="Property" />
        <Localized key="property_label" lang="French" value="Propriété" />
        <Localized key="rename_button" lang="English" value="Rename…" />
        <Localized key="rename_button" lang="French" value="Renommer…" />
        <Localized key="change_type_button" lang="English" value="Set…" />
        <Localized key="change_type_button" lang="French" value="Définir…" />
        <Localized key="accessors" lang="English" value="Accessors" />
        <Localized key="accessors" lang="French" value="Accesseurs" />
        <Localized key="advanced" lang="English" value="Advanced" />
        <Localized key="advanced" lang="French" value="Avancé" />
        <Localized key="identifier" lang="English" value="Identifier" />
        <Localized key="identifier" lang="French" value="Identifiant" />
        <Localized key="cardinality" lang="English" value="Cardinality" />
        <Localized key="cardinality" lang="French" value="Cardinalité" />
        <Localized key="type" lang="English" value="Type" />
        <Localized key="type" lang="French" value="Type" />
        <Localized key="default_value" lang="English" value="Default value" />
        <Localized key="default_value" lang="French" value="Valeur par défaut" />
        <Localized key="derived" lang="English" value="Derived" />
        <Localized key="derived" lang="French" value="Dérivé" />
        <Localized key="embedded" lang="English" value="Embedded" />
        <Localized key="embedded" lang="French" value="Embarqué" />
        <Localized key="ignore_type" lang="English" value="Ignore type" />
        <Localized key="ignore_type" lang="French" value="Ignorer le type" />
        <Localized key="ignore_for_equality" lang="English" value="Ignore for equality" />
        <Localized key="ignore_for_equality" lang="French" value="Ignorer (égalité)" />
        <Localized key="allows_multiple" lang="English" value="Allows multiple" />
        <Localized key="allows_multiple" lang="French" value="Occurrences multiples" />
        <Localized key="getter" lang="English" value="Getter" />
        <Localized key="getter" lang="French" value="Getter" />
        <Localized key="setter" lang="English" value="Setter" />
        <Localized key="setter" lang="French" value="Setter" />
        <Localized key="updater" lang="English" value="Updater" />
        <Localized key="updater" lang="French" value="Updater" />
        <Localized key="adder" lang="English" value="Adder" />
        <Localized key="adder" lang="French" value="Adder" />
        <Localized key="remover" lang="English" value="Remover" />
        <Localized key="remover" lang="French" value="Remover" />
        <Localized key="reindexer" lang="English" value="Reindexer" />
        <Localized key="reindexer" lang="French" value="Reindexer" />
        <Localized key="inverse" lang="English" value="Inverse" />
        <Localized key="inverse" lang="French" value="Inverse" />
        <Localized key="identifier_style" lang="English" value="Identifier style" />
        <Localized key="identifier_style" lang="French" value="Style d&apos;identifiant" />
        <Localized key="constant_name" lang="English" value="Constant" />
        <Localized key="constant_name" lang="French" value="Constante" />
    </LocalizedDictionary>
    <Parameter name="title" value="Property" />
</Inspector>
