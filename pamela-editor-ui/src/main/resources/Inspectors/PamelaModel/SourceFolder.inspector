<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="twocols" darkLevel="0" font="SansSerif,0,11"
    dataClassName="org.openflexo.pamela.editor.model.SourceFolder" name="Inspector">
    <Label name="NameLabel" label="name" index="0"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="NameTF" index="1" data="data.name" readOnly="true"
        constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="15" localize="true" />
    <Label name="PathLabel" label="path" index="2"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="PathTF" index="3" data="data.path" readOnly="true"
        constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="15" localize="true" />
    <Label name="PackagesLabel" label="packages" index="4"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="PackagesTF" index="5" data="data.packages.size" readOnly="true"
        constraints="twocols(location=right;insetsRight=5)" columns="5" localize="true" />
    <Label name="EntitiesLabel" label="entities" index="6"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="EntitiesTF" index="7" data="data.entities.size" readOnly="true"
        constraints="twocols(location=right;insetsRight=5)" columns="5" localize="true" />
    <LocalizedDictionary>
        <Localized key="name" lang="English" value="Name" />
        <Localized key="name" lang="French" value="Nom" />
        <Localized key="path" lang="English" value="Path" />
        <Localized key="path" lang="French" value="Chemin" />
        <Localized key="packages" lang="English" value="Packages" />
        <Localized key="packages" lang="French" value="Paquetages" />
        <Localized key="entities" lang="English" value="Entities" />
        <Localized key="entities" lang="French" value="Entités" />
    </LocalizedDictionary>
    <Parameter name="title" value="Source folder" />
</Inspector>
