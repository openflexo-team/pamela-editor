<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="border" darkLevel="0" font="SansSerif,0,11"
    dataClassName="org.openflexo.pamela.editor.diagram.PamelaClassDiagram" name="Inspector"
    border="empty" borderTop="6" borderBottom="6" borderLeft="6" borderRight="6">

  <!-- Entity look applied to all boxes of this diagram -->
  <Panel name="entityPanel" layout="twocols" constraints="border(location=north)"
         titleFont="SansSerif,1,11" border="rounded3d"
         borderTop="2" borderBottom="2" borderLeft="2" borderRight="2" borderTitle="entities">
    <Label name="HeaderColorLabel" label="header_background" index="0"
        constraints="twocols(location=left)" localize="true" />
    <Color name="HeaderColor" index="1" data="data.entityStyle.headerBackgroundColor" allowsNull="false"
        constraints="twocols(location=right)" />
    <Label name="BodyColorLabel" label="body_background" index="2"
        constraints="twocols(location=left)" localize="true" />
    <Color name="BodyColor" index="3" data="data.entityStyle.bodyBackgroundColor" allowsNull="false"
        constraints="twocols(location=right)" />
    <Label name="BorderColorLabel" label="border_color" index="4"
        constraints="twocols(location=left)" localize="true" />
    <Color name="BorderColor" index="5" data="data.entityStyle.borderColor" allowsNull="false"
        constraints="twocols(location=right)" />
    <Label name="TitleFontLabel" label="title_font" index="6"
        constraints="twocols(location=left)" localize="true" />
    <Font name="TitleFont" index="7" data="data.entityStyle.titleFont" allowsNull="false"
        constraints="twocols(expandHorizontally=true;location=right)" />
    <Label name="MemberFontLabel" label="member_font" index="8"
        constraints="twocols(location=left)" localize="true" />
    <Font name="MemberFont" index="9" data="data.entityStyle.memberFont" allowsNull="false"
        constraints="twocols(expandHorizontally=true;location=right)" />
  </Panel>

  <!-- Connector styles used by this diagram (master-detail; styles are captured by use) -->
  <Panel name="connectorPanel" layout="border" constraints="border(location=center)"
         titleFont="SansSerif,1,11" border="rounded3d"
         borderTop="2" borderBottom="2" borderLeft="2" borderRight="2" borderTitle="connectors">
    <Table name="dgStylesTable" data="data.connectorStyles"
           iteratorClassName="org.openflexo.pamela.editor.ui.preferences.ConnectorStylePreference"
           selectionMode="SingleSelection" visibleRowCount="4" rowHeight="18"
           createNewRowOnClick="false" showFooter="false" autoSelectFirstRow="true"
           constraints="border(location=north)">
      <LabelColumn name="dgNameCol" data="iterator.name" title="name" columnWidth="150" resizable="true" displayTitle="true" />
      <LabelColumn name="dgTypeCol" data="iterator.connectorType.name" title="type" columnWidth="110" resizable="true" displayTitle="true" />
    </Table>
    <Panel name="dgDetailPanel" layout="twocols" constraints="border(location=center)">
      <Label name="dgStyleNameLabel" label="name" index="0" constraints="twocols(location=left)" localize="true" />
      <TextField name="dgStyleNameTF" index="1" data="dgStylesTable.selected.name"
          enable="dgStylesTable.selected != null" columns="16"
          constraints="twocols(expandHorizontally=true;location=right)" />
      <Label name="dgStyleTypeLabel" label="connector_type" index="2" constraints="twocols(location=left)" localize="true" />
      <DropDown name="dgStyleTypeDD" index="3" data="dgStylesTable.selected.connectorType"
          iteratorClassName="org.openflexo.diana.connectors.ConnectorSpecification$ConnectorType"
          format="object.name" enable="dgStylesTable.selected != null" width="130"
          constraints="twocols(expandHorizontally=true;location=right)" />
      <Label name="dgStyleColorLabel" label="color" index="4" constraints="twocols(location=left)" localize="true" />
      <Color name="dgStyleColor" index="5" data="dgStylesTable.selected.color" allowsNull="false"
          enable="dgStylesTable.selected != null" constraints="twocols(location=right)" />
      <Label name="dgStyleWidthLabel" label="line_width" index="6" constraints="twocols(location=left)" localize="true" />
      <Number name="dgStyleWidth" index="7" data="dgStylesTable.selected.lineWidth" numberType="DoubleType"
          minValue="0.5" maxValue="10.0" increment="0.5" columns="5"
          enable="dgStylesTable.selected != null" constraints="twocols(location=right)" />
      <Label name="dgStyleRoundedLabel" label="rounded" index="8" constraints="twocols(location=left)" localize="true" />
      <CheckBox name="dgStyleRounded" index="9" data="dgStylesTable.selected.rounded"
          enable="dgStylesTable.selected != null" constraints="twocols(location=right)" />
    </Panel>
  </Panel>

  <!-- Default connector styles for this diagram -->
  <Panel name="dgDefaultsPanel" layout="twocols" constraints="border(location=south)"
         titleFont="SansSerif,1,11" border="rounded3d"
         borderTop="2" borderBottom="2" borderLeft="2" borderRight="2" borderTitle="default_styles">
    <Label name="dgDefInhLabel" label="default_inheritance" index="0" constraints="twocols(location=left)" localize="true" />
    <DropDown name="dgDefInhDD" index="1" data="data.defaultInheritanceStyle" list="data.connectorStyles"
        iteratorClassName="org.openflexo.pamela.editor.ui.preferences.ConnectorStylePreference"
        format="object.name" width="170"
        constraints="twocols(expandHorizontally=true;location=right)" />
    <Label name="dgDefAssocLabel" label="default_association" index="2" constraints="twocols(location=left)" localize="true" />
    <DropDown name="dgDefAssocDD" index="3" data="data.defaultAssociationStyle" list="data.connectorStyles"
        iteratorClassName="org.openflexo.pamela.editor.ui.preferences.ConnectorStylePreference"
        format="object.name" width="170"
        constraints="twocols(expandHorizontally=true;location=right)" />
  </Panel>

    <LocalizedDictionary>

    <Localized key="connectors" lang="English" value="Connectors" />
    <Localized key="connectors" lang="French" value="Connecteurs" />
    <Localized key="connectors" lang="Dutch" value="Verbindingen" />
    <Localized key="header_background" lang="Dutch" value="Achtergrond (kop)" />
    <Localized key="body_background" lang="Dutch" value="Achtergrond (body)" />
    <Localized key="connector_type" lang="English" value="Routing" />
    <Localized key="connector_type" lang="French" value="Routage" />
    <Localized key="connector_type" lang="Dutch" value="Routering" />
    <Localized key="rounded" lang="English" value="Rounded corners" />
    <Localized key="rounded" lang="French" value="Coins arrondis" />
    <Localized key="rounded" lang="Dutch" value="Afgeronde hoeken" />
  </LocalizedDictionary>
  <Parameter name="title" value="Diagram" />
</Inspector>
