<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="twocols" darkLevel="0" font="SansSerif,0,11"
    dataClassName="org.openflexo.pamela.editor.model.SourceModelInitializer" name="Inspector">
    <Label name="InitializerLabel" label="initializer" index="0"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="InitializerTF" index="1" data="data.displayLabel" readOnly="true"
        constraints="twocols(expandHorizontally=true;location=right)" columns="15" localize="true" />
    <Label name="EntityLabel" label="entity" index="2"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="EntityTF" index="3" data="data.entity.simpleName" readOnly="true"
        constraints="twocols(expandHorizontally=true;location=right)" columns="15" localize="true" />
    <Label name="NoGeometryNote" label="no_geometry_note" index="4"
        constraints="twocols(expandHorizontally=true;location=center)" localize="true" />
    <LocalizedDictionary>
        <Localized key="initializer" lang="English" value="Initializer" />
        <Localized key="initializer" lang="French" value="Initialiseur" />
        <Localized key="entity" lang="English" value="Entity" />
        <Localized key="entity" lang="French" value="Entité" />
        <Localized key="no_geometry_note" lang="English" value="Row of the entity box — no own graphical geometry." />
        <Localized key="no_geometry_note" lang="French" value="Ligne de la boîte d'entité — pas de géométrie graphique propre." />
    </LocalizedDictionary>
    <Parameter name="title" value="Initializer" />
</Inspector>
