<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="twocols" darkLevel="0" font="SansSerif,0,11"
    dataClassName="org.openflexo.pamela.editor.model.SourceCustomMethod" name="Inspector">
    <Label name="MethodLabel" label="method" index="0"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="MethodTF" index="1" data="data.signature" readOnly="true"
        constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="15" localize="true" />
    <Label name="KindLabel" label="kind" index="2"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="KindTF" index="3" data="data.kind.toString" readOnly="true"
        constraints="twocols(;insetsRight=5location=right)" columns="10" localize="true" />
    <Label name="EntityLabel" label="entity" index="4"
        constraints="twocols(location=left)" localize="true" />
    <TextField name="EntityTF" index="5" data="data.entity.simpleName" readOnly="true"
        constraints="twocols(expandHorizontally=true;insetsRight=5;location=right)" columns="15" localize="true" />
    <Label name="NoGeometryNote" label="no_geometry_note" index="6"
        constraints="twocols(expandHorizontally=true;location=center)" localize="true" />
    <LocalizedDictionary>        <Localized key="method" lang="English" value="Method" />
        <Localized key="method" lang="French" value="Méthode" />
        <Localized key="method" lang="Dutch" value="Methode" />
    </LocalizedDictionary>
    <Parameter name="title" value="Method" />
</Inspector>
