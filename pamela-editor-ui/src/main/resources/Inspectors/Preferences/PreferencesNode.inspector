<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="twocols" darkLevel="0" font="SansSerif,1,12"
    dataClassName="org.openflexo.pamela.editor.ui.preferences.PreferencesNode" name="Inspector">
    <Label name="ThemeLabel" label="theme" index="0"
        constraints="twocols(location=left)" localize="true" />
    <Label name="ThemeValue" label="data.displayLabel" index="1" localize="false"
        constraints="twocols(expandHorizontally=true;location=right)" />
    <LocalizedDictionary>
        <Localized key="theme" lang="English" value="Theme" />
        <Localized key="theme" lang="French" value="Thème" />
        <Localized key="theme" lang="Dutch" value="Thema" />
    </LocalizedDictionary>
    <Parameter name="title" value="Preferences" />
</Inspector>
