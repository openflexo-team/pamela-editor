<?xml version="1.0" encoding="UTF-8"?>
<Inspector layout="twocols" darkLevel="0" font="SansSerif,0,11"
    dataClassName="org.openflexo.pamela.editor.ui.preferences.EntityStylePreferences" name="Inspector">
    <Label name="HeaderColorLabel" label="header_background" index="10"
        constraints="twocols(location=left)" localize="true" />
    <Color name="HeaderColor" index="11" data="data.headerBackgroundColor" allowsNull="false"
        constraints="twocols(location=right)" />
    <Label name="BodyColorLabel" label="body_background" index="12"
        constraints="twocols(location=left)" localize="true" />
    <Color name="BodyColor" index="13" data="data.bodyBackgroundColor" allowsNull="false"
        constraints="twocols(location=right)" />
    <Label name="BorderColorLabel" label="border_color" index="14"
        constraints="twocols(location=left)" localize="true" />
    <Color name="BorderColor" index="15" data="data.borderColor" allowsNull="false"
        constraints="twocols(location=right)" />
    <Label name="TitleFontLabel" label="title_font" index="16"
        constraints="twocols(location=left)" localize="true" />
    <Font name="TitleFont" index="17" data="data.titleFont" allowsNull="false"
        constraints="twocols(expandHorizontally=true;location=right)" />
    <Label name="MemberFontLabel" label="member_font" index="18"
        constraints="twocols(location=left)" localize="true" />
    <Font name="MemberFont" index="19" data="data.memberFont" allowsNull="false"
        constraints="twocols(expandHorizontally=true;location=right)" />
    <LocalizedDictionary>        <Localized key="header_background" lang="English" value="Header background" />
        <Localized key="header_background" lang="French" value="Fond de l'en-tête" />
        <Localized key="header_background" lang="Dutch" value="Achtergrond kop" />
        <Localized key="body_background" lang="English" value="Body background" />
        <Localized key="body_background" lang="French" value="Fond du corps" />
        <Localized key="body_background" lang="Dutch" value="Achtergrond body" />
        <Localized key="border_color" lang="English" value="Border color" />
        <Localized key="border_color" lang="French" value="Couleur de bordure" />
        <Localized key="border_color" lang="Dutch" value="Randkleur" />
        <Localized key="title_font" lang="English" value="Title font" />
        <Localized key="title_font" lang="French" value="Police du titre" />
        <Localized key="title_font" lang="Dutch" value="Titellettertype" />
        <Localized key="member_font" lang="English" value="Member font" />
        <Localized key="member_font" lang="French" value="Police des membres" />
